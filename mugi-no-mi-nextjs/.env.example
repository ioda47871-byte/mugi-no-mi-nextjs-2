# サイトの公開URL(本番ドメイン確定後に設定。sitemap.ts / robots.ts / OGPで使用)
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase(商品データ・管理者認証に使用。lib/products.ts, lib/supabase/ 参照)
# Project Settings > API から取得してください。
# 重要: ここに設定するのは "anon / public" キーのみです。
# service_role(secret)キーは絶対にNEXT_PUBLIC_を付けず、サーバー専用の変数にもこのプロジェクトでは使用していません。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# お問い合わせフォーム: メール送信(Resend。lib/contact/email.ts 参照)
# いずれもサーバー専用です。NEXT_PUBLIC_は付けないでください。
RESEND_API_KEY=
# 送信元アドレス。実運用ではResendでドメイン認証(SPF/DKIM)したドメインを使用してください。
RESEND_FROM_EMAIL=
# 本番(VERCEL_ENV=production)でのみ使用する実店舗の受信先。
CONTACT_FORM_TO_EMAIL=
# Preview/Development(本番以外)でのみ使用するテスト用受信先。
# 本番以外でCONTACT_FORM_TO_EMAILへフォールバックすることはありません。
CONTACT_FORM_TEST_TO_EMAIL=

# お問い合わせフォーム: レート制限(lib/contact/ip.ts, lib/contact/rate-limit.ts 参照)
# サーバー専用。IPアドレスをHMAC-SHA256でハッシュ化する際の鍵として使用します。
# 32文字以上のランダムな値を設定してください(例: openssl rand -hex 32)。
CONTACT_RATE_LIMIT_SECRET=
# Upstash Redis(Vercel MarketplaceのUpstash連携で自動的に設定されます)。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Instagram連携(トップページ下部の最新投稿。lib/instagram/ 参照)。
# いずれもサーバー専用です。NEXT_PUBLIC_は付けないでください(クライアントに公開しない)。
#
# Instagram Graph API(Instagram Business/Creatorアカウント)の投稿取得先ユーザーID。
INSTAGRAM_USER_ID=
#
# 初回のみ使用する「初期」長期アクセストークン(有効期間 約60日)。
# Supabase(instagram_credentialsテーブル)にまだトークンが保存されていない場合のみ
# 使用され、可能であれば自動的にSupabaseへ保存されます。以後はSupabase側の
# トークンが正となり、Vercel Cronが約30日ごとに自動更新するため、
# この値を手動で更新し続ける必要はありません(README「9. Instagram連携」参照)。
# 通常のSupabase接続用キー(NEXT_PUBLIC_SUPABASE_ANON_KEY)とは別物です。
INSTAGRAM_INITIAL_ACCESS_TOKEN=
#
# SupabaseのService Roleキー(Project Settings > API > service_role)。
# RLSを完全にバイパスする強力な鍵です。以下の2ファイル以外では使用しないでください。
# NEXT_PUBLIC_SUPABASE_ANON_KEYと混同しないこと。
#   - lib/instagram/token-store.ts
#   - app/api/cron/cleanup-orphaned-site-photos/route.ts(サイト写真の孤立ファイル削除)
SUPABASE_SERVICE_ROLE_KEY=
#
# Vercel Cron(app/api/cron/refresh-instagram-token,
# app/api/cron/cleanup-orphaned-site-photos)を保護するための秘密値。
# 32文字以上のランダムな値を設定してください(例: openssl rand -hex 32)。
# Vercel側でCRON_SECRETを設定すると、Cronからのリクエストに
# Authorization: Bearer {CRON_SECRET} ヘッダーが自動的に付与されます。
CRON_SECRET=
#
# いずれか未設定・期限切れなど取得に失敗した場合は、エラー画面ではなく
# 「最新情報はInstagramをご覧ください。」という案内とボタンのみが表示されます。

# 商品一覧の表示可否(lib/products.ts 参照)。
# 'true' の場合のみSupabase/JSONフォールバックから商品を取得して表示します。
# 未設定(既定)の場合は常に商品0件を返し、公開ページには何も表示されません。
# Supabaseのproductsテーブルに旧ブランドの仮データが残っている状態で誤って
# 表示してしまうことを防ぐための安全装置です。実際の商品データが確認でき、
# 表示してよい状態になってから 'true' に設定してください。
ENABLE_PRODUCT_LISTING=
