{
  "name": "travel-goods-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "build:only": "next build",
    "start": "npx --yes serve@14.2.6 -l 3100 out",
    "preview": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run preview:cta && playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:content:all": "tsx scripts/validate-content.ts --all",
    "check:release": "tsx scripts/check-release.ts",
    "create:draft": "tsx scripts/create-draft.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run validate:content:all && npm run build:only",
    "preview:cta": "tsx --tsconfig tsconfig.scripts.json scripts/cta-preview.ts",
    "test:e2e:only": "playwright test",
    "test:e2e:production": "CATALOG_DATASET=production npm run build:only && npm run preview:cta && E2E_DATASET=production playwright test",
    "link:set": "tsx scripts/set-merchant-link.ts",
    "preview:linkcheck": "tsx scripts/linkcheck-fixture.ts",
    "test:e2e:linkcheck": "npm run preview:linkcheck && CATALOG_DATASET=production CATALOG_DATASET_DIR=.preview/linkcheck-dataset NEXT_PUBLIC_GA_ID=G-LINKCHECK npm run build:only && npm run preview:cta && E2E_DATASET=linkcheck playwright test"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
