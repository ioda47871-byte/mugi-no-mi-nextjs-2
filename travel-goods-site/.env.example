# ============================================================
# travel-goods-site 環境変数テンプレート（計画書 8節「環境変数の契約」）
#
# ここには「変数名と説明」だけを置く。実際のキー・紹介ID・個人情報は書かない。
# 実値は .env.local（gitignore 済み）か、ホスティング側の安全な入力欄に設定する。
# 未設定でもサイトはビルド・閲覧でき、該当機能だけが安全側（無効）に倒れる。
# ============================================================

# --- サイト識別 -------------------------------------------------
# 表示名。未設定なら仮称「旅じたくガイド」を使う。正式名称・商標確認は未実施。
SITE_NAME=
# 正規URL（canonical / sitemap / robots の基準）。末尾スラッシュなし。
# 例: https://example.com  ※プレビュー環境と本番で必ず別の値にする。
SITE_URL=

# preview | production
# preview: 全ページ noindex。デモデータセットの使用を許可。
# production: check:release を通してから設定する。デモデータは使用不可。
SITE_MODE=preview

# production | demo
# 未設定時は SITE_MODE=preview なら demo、production なら production。
CATALOG_DATASET=

# --- 公開用の運営者情報（ユーザーから提供されたものだけを入れる） --
# 架空の氏名・住所・連絡先を入れない。未設定なら該当箇所に「未設定」と表示する。
PUBLIC_OPERATOR_NAME=
PUBLIC_CONTACT_EMAIL=

# --- アフィリエイト -------------------------------------------------
# Amazonアソシエイトの本人トラッキングID（例: yourname-22）。
# 空の場合、Amazonボタンは一切出力されない。
AMAZON_ASSOCIATE_TAG=

# 楽天は Phase 1 では「管理画面で発行済みの紹介URL」を
# datasets/<dataset>/merchants/rakuten.json に登録して使う。ここにキーは不要。

# --- 計測 -------------------------------------------------
# GA4 測定ID（例: G-XXXXXXXXXX）。空なら計測タグを出力せず、送信も行わない。
NEXT_PUBLIC_GA_ID=

# --- Phase 2 用（Phase 1 では未使用・空のままで動く） -----------------
# 楽天ウェブサービス。NEXT_PUBLIC_ を付けないこと（ビルド成果物に含めない）。
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# AI/API を使う更新ジョブを採用する場合のみ。Phase 1 では不要。
ANTHROPIC_API_KEY=

# 自動更新ジョブの有効化フラグ。既定は false。
AUTOMATION_ENABLED=false
# 承認済みの月次上限(USD)。0 のうちは有料処理を開始しない。
LLM_MONTHLY_BUDGET_USD=0
